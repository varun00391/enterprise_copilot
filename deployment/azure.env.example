# Copy to deployment/azure.env and fill in before running scripts.
#   cp deployment/azure.env.example deployment/azure.env
# Never commit azure.env (see repository .gitignore).

# Azure subscription
AZURE_SUBSCRIPTION_ID=

# Region (e.g. eastus, westus2, swedencentral)
AZURE_LOCATION=eastus

# Names (Container App / ACR names must be globally unique where noted)
RESOURCE_GROUP=rg-orgmind-prod
ACR_NAME=acrorgmindxyz
LOG_ANALYTICS_WORKSPACE=law-orgmind
CONTAINER_APPS_ENV=env-orgmind

# Public Container Apps — backend API + SPA (nginx proxies /api → backend ingress)
CONTAINER_APP_BACKEND=orgmind-api
CONTAINER_APP_FRONTEND=orgmind-web

# Internal dependency Container Apps (same environment)
CONTAINER_APP_QDRANT=orgmind-qdrant
CONTAINER_APP_MINIO=orgmind-minio

# PostgreSQL Flexible Server (server name globally unique across Azure)
POSTGRES_SERVER_NAME=orgmind-pg-unique
POSTGRES_ADMIN_USER=orgmind
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DATABASE=orgmind

# Azure Cache for Redis — Basic C0 (see `az redis create --vm-size` options)
REDIS_NAME=orgmind-redis-unique
REDIS_SKU=Basic
REDIS_VM_SIZE=c0

# MinIO bucket (matches backend MINIO_BUCKET)
MINIO_BUCKET=orgmind-documents
MINIO_ROOT_USER=orgmindminio
MINIO_ROOT_PASSWORD=

# ACR repositories (without registry hostname)
IMAGE_BACKEND=orgmind/backend
IMAGE_FRONTEND=orgmind/frontend

# JWT / crypto — REQUIRED for production (set a long random secret)
APP_SECRET_KEY=

# Optional: knowledge graph (Neo4j) — default off for this IaC path
# GRAPH_RAG_ENABLED=false
# NEO4J_URI=

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.euron.one/api/v1/euri
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GitHub OIDC (populate after scripts/06-github-actions-identity.sh)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# GitHub repository for federated credential (owner/repo)
GITHUB_REPO=your-github-username/enterprise_copilot
